# ── Self-Healing Provider ──────────────────────────────────────────────────
# Which AI provider to use for selector healing
# Options: claude | openai | gemini | ollama | grok
HEALING_PROVIDER=claude

# Healing mode
# off    — self-healing disabled
# report — print suggestions to console + write reports/healing-report.json
# auto   — automatically rewrite broken selectors in step files
HEALING_MODE=report

# Minimum confidence (0.0–1.0) required before a suggestion is used
HEALING_CONFIDENCE_THRESHOLD=0.7

# ── Claude (Anthropic) ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key
CLAUDE_MODEL=claude-sonnet-4-20250514

# ── OpenAI ────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o

# ── Gemini (Google) ───────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# ── Ollama (local or cloud) ──────────────────────────────────────────────
# For cloud: set OLLAMA_HOST to the cloud endpoint and add OLLAMA_API_KEY
OLLAMA_HOST=https://api.ollama.ai
OLLAMA_API_KEY=your-ollama-api-key
OLLAMA_MODEL=llama3.2

# ── Grok (xAI) ───────────────────────────────────────────────────────────
GROK_API_KEY=your-grok-api-key
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-3
